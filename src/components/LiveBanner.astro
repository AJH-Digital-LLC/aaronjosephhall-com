<aside aria-label="Jubilee City Church livestream" class="live-banner">
  <div>
    <p>Jubilee City Church online · Sundays at 10 AM Central</p>
    <p id="sunday-invitation" hidden>It’s Sunday. Join us online.</p>
    <span id="service-countdown">Next service: Sunday at 10:00 AM Central</span>
  </div>
  <a href="/live/">Watch LIVE <span aria-hidden="true">↗</span></a>
</aside>
<script>
  import { liveSchedule } from '@/lib/live-schedule';
  const countdown = document.getElementById('service-countdown');
  const invitation = document.getElementById('sunday-invitation');
  function update() {
    const schedule = liveSchedule(Date.now());
    if (invitation) invitation.hidden = !schedule.isSunday;
    if (countdown) countdown.textContent = schedule.afterStart ? 'Watch today’s service or the latest replay.' : `Next Sunday service in ${schedule.countdown}`;
  }
  update();
  window.setInterval(update, 1000);
</script>
<style>
  .live-banner { background:#193b32; color:#fffdf5; padding: .9rem max(1.5rem, calc((100% - 72rem)/2 + 1.5rem)); display:flex; justify-content:space-between; gap:1rem; align-items:center; }
  p { margin:0; font-size:.85rem; font-weight:600; }
  #sunday-invitation { font-family:var(--font-display); font-size:1.5rem; margin:.3rem 0; }
  span { font-size:.8rem; color:#e9eadf; }
  a { flex-shrink:0; border:1px solid #e3c58b; border-radius:6px; padding:.65rem 1rem; color:#193b32; background:#f3d9a6; font-weight:700; }
  a span { color:inherit; }
  a:focus-visible { outline:3px solid white; outline-offset:4px; }
  @media(max-width:520px) { .live-banner { align-items:flex-start; flex-direction:column; } }
</style>
