---
import { LEGAL_LINKS, NAV_LINKS, SITE, SOCIAL_LINKS } from "@/data/site";
import NewsletterForm from "@/components/NewsletterForm.astro";

interface Props {
  /** Omit the embedded newsletter form, e.g. on a page that already features it. */
  hideNewsletterForm?: boolean;
}

const { hideNewsletterForm = false } = Astro.props;
const year = new Date().getFullYear();
---

<style>
  .footer-signup { width: 100%; max-width: 38rem; min-width: 0; background: #fffefa; color: #202d25; padding: clamp(1.25rem,3vw,2.5rem); border-radius: 18px; border-top: 5px solid #f2d298; box-shadow: 0 20px 50px #071c1840; }
  .signup-eyebrow { color: #71351e; text-transform: uppercase; font-size: .8rem; letter-spacing: .1em; font-weight: 700; margin-bottom: 1.2rem; }
  .signup-note { color: #414e44; font-size: .875rem; line-height: 1.6; border-top: 1px solid #bec9bd; padding-top: 1rem; margin-top: 1rem; }
</style>

<footer class="border-t border-ink/10 mt-24">
  <div class="mx-auto max-w-6xl px-6 py-14 grid gap-10 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <p class="font-display text-lg text-ink">{SITE.name}</p>
      <p class="mt-2 text-sm text-stone max-w-xs">{SITE.tagline}</p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <p class="eyebrow mb-3">Site</p>
      <ul class="space-y-2">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="text-ink-soft hover:text-clay">{link.label}</a></li>
        ))}
        <li><a href="/articles/categories/" class="text-ink-soft hover:text-clay">Blog categories</a></li>
        <li><a href="/sitemap.xml" class="text-ink-soft hover:text-clay">Sitemap</a></li>
      </ul>
    </nav>

    <div class="text-sm">
      <p class="eyebrow mb-3">Connect</p>
      <ul class="space-y-2">
        <li><a href="/rss.xml" class="text-ink-soft hover:text-clay">RSS feed</a></li>
        {SOCIAL_LINKS.map((s) => (
          <li><a href={s.href} target="_blank" rel="noreferrer" class="text-ink-soft hover:text-clay">{s.label}</a></li>
        ))}
        <li><a href="https://jubileecity.church" class="text-ink-soft hover:text-clay">Jubilee City Church</a></li>
        <li><span class="text-ink-soft">aaron [at] aaronjosephhall [dot] com</span></li>
      </ul>
    </div>

    <nav aria-label="Legal" class="text-sm">
      <p class="eyebrow mb-3">Legal</p>
      <ul class="space-y-2">
        {LEGAL_LINKS.map((link) => (
          <li><a href={link.href} class="text-ink-soft hover:text-clay">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="bg-pine">
    {!hideNewsletterForm && (
      <div class="border-b border-parchment/15">
        <div class="mx-auto max-w-6xl px-6 py-14 flex justify-center">
          <div class="footer-signup">
            <p class="signup-eyebrow">Make room for encouragement</p>
            <NewsletterForm />
            <p class="signup-note">Read when you have a quiet moment. Unsubscribe anytime.</p>
          </div>
        </div>
      </div>
    )}

  </div>

  <div class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-5 text-sm text-stone flex flex-wrap gap-x-4 gap-y-3 justify-between">
      <p>&copy; {year} <a href="https://ajhventuresllc.com/" class="hover:text-clay underline">AJH Ventures LLC</a>. All rights reserved.</p>
      <a href="https://ajhdigital.com/" class="hover:text-clay underline">Website designed &amp; managed by AJH Digital</a>
      <p class="w-full">AJH Digital is a brand/DBA of <a href="https://ajhventuresllc.com/" class="hover:text-clay underline">AJH Ventures LLC</a>.</p>
    </div>
  </div>
</footer>
