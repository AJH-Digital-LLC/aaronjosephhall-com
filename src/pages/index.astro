---
export const prerender = true;
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { SITE } from "@/data/site";

const latestArticles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 6);

const [featuredBook] = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
const bookSummary = featuredBook
  ? [featuredBook.data.title, featuredBook.data.subtitle].filter(Boolean).join(": ")
  : "Books";
---

<BaseLayout
  title={SITE.name}
  description="Writing on faith, family, discipleship, and life in ministry from pastor and author Aaron Joseph Hall."
  path="/"
>
  <section class="home-intro border-b border-ink/10">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24 grid gap-10 md:grid-cols-[1.5fr_1fr] items-center">
      <div>
        <p class="eyebrow">Aaron Joseph Hall · Pastor &amp; author</p>
        <h1 class="mt-5 text-5xl md:text-7xl leading-[1.02]">Faith in the<br /><em>ordinary days.</em></h1>
        <p class="mt-6 max-w-xl text-lg text-stone">
          I'm a pastor, husband, father, and author. This is my ministry blog — writing on life,
          faith, family, and ministry, and following Jesus in the everyday.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/articles" class="rounded-full bg-clay text-parchment px-6 py-3 text-sm font-medium hover:bg-clay-dark transition-colors">
            Read the writing
          </a>
          <a href="/about" class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink hover:border-ink hover:bg-ink/5 transition-colors">
            Meet Aaron
          </a>
        </div>
      </div>
      <div class="portrait-frame aspect-[4/5] overflow-hidden bg-parchment-dim">
        <img
          src="/AaronJosephHall.jpg"
          alt={SITE.name}
          width="1500"
          height="1501"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="section-heading"><p class="eyebrow">From the journal</p><h2>Latest writing</h2></div>
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {latestArticles.map((entry) => <li><ArticleCard entry={entry} /></li>)}
    </ul>
    <div class="mt-12 flex justify-center">
      <a href="/articles" class="rounded-full border border-ink/20 px-6 py-3 text-sm font-medium text-ink hover:border-ink hover:bg-ink/5 transition-colors">
        View All Writings
      </a>
    </div>
  </section>

  <section class="border-t border-ink/10 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {[
        {
          label: "Speaking",
          href: "/speaking",
          copy: "Aaron speaks on Leadership, Church Planting, Faith, Culture, and more, bringing honest conversations and practical biblical insight to churches, conferences, and events.",
        },
        { label: "Books", href: "/books", copy: bookSummary },
        { label: "Newsletter", href: "/newsletter", copy: "Get new writing and updates in your inbox." },
      ].map((card) => (
        <a
          href={card.href}
          class="group block rounded-2xl border border-ink/10 bg-white shadow-sm p-6 hover:shadow-md transition-shadow"
        >
          <h2 class="font-display text-xl group-hover:text-clay">{card.label}</h2>
          <p class="mt-2 text-sm text-stone">{card.copy}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
