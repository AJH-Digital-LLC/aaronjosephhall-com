---
export const prerender = true;
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Books"
  description="Books by Aaron Joseph Hall."
  path="/books"
>
  <section class="border-b border-ink/10 bg-parchment-dim/50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">Books</p>
      <h1 class="mt-3 text-4xl md:text-6xl max-w-3xl">Hope for the next chapter.</h1>
      <p class="mt-6 max-w-2xl text-lg text-stone">Books by Aaron Joseph Hall, exploring faith, redemption, and the stories God is still writing.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <ul class="book-library">
      {books.map((book) => (
        <li>
          <a href={`/books/${book.id}/`} class="book-library-card group">
            <div class="book-cover-stage">
              {book.data.cover ? (
                <img
                  src={book.data.cover}
                  alt={book.data.coverAlt ?? `${book.data.title} book cover`}
                  class="book-cover"
                  width="550" height="850" loading="lazy"
                />
              ) : (
                <div class="h-full w-full flex items-center justify-center">
                  <span class="font-display text-stone text-xs px-2 text-center opacity-60">Cover pending</span>
                </div>
              )}
            </div>
            <div class="book-library-copy">
              <p class="eyebrow mb-4">By Aaron Joseph Hall</p>
              <h2 class="font-display text-3xl md:text-4xl text-ink group-hover:text-clay">{book.data.title}</h2>
              {book.data.subtitle && <p class="mt-1 text-stone">{book.data.subtitle}</p>}
              <p class="mt-6 text-lg text-stone">{book.data.excerpt}</p>
              {book.data.pageCount && <p class="mt-5 text-sm text-stone">{book.data.pageCount} pages · {book.data.language ?? "English"}</p>}
              <span class="action-link mt-8">Explore the book &rarr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
