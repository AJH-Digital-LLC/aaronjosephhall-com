---
export const prerender = true;
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ArticleShare from "@/components/ArticleShare.astro";
import AuthorBox from "@/components/AuthorBox.astro";
import CategoryNav from "@/components/CategoryNav.astro";
import ContentPendingNotice from "@/components/ContentPendingNotice.astro";
import AffiliateDisclosure from "@/components/AffiliateDisclosure.astro";
import { formatDate, readingTime } from "@/lib/format";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: articles },
  }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  date,
  category,
  excerpt,
  image,
  imageAlt,
  author,
  seoTitle,
  seoDescription,
  contentPending,
  aiDraft,
} = entry.data;

const sorted = [...all].sort((a, b) => (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0));
const currentIndex = sorted.findIndex((a) => a.id === entry.id);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : undefined;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : undefined;

const related = all
  .filter((a) => a.id !== entry.id && category && a.data.category === category)
  .slice(0, 3);

const rawBody = entry.body ?? "";
const minutes = readingTime(rawBody);
const shareImage = image ? await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 85 }) : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: excerpt,
  author: { "@type": "Person", name: author },
  ...(date ? { datePublished: date.toISOString() } : {}),
  publisher: { "@type": "Person", name: SITE.name },
  mainEntityOfPage: new URL(`/articles/${entry.id}`, SITE.url).toString(),
};
---

<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? excerpt}
  path={`/articles/${entry.id}`}
  type="article"
  publishedTime={date}
  image={shareImage?.src}
  imageWidth={shareImage ? 1200 : undefined}
  imageHeight={shareImage ? 630 : undefined}
  imageAlt={imageAlt ?? title}
  imageType={shareImage ? "image/jpeg" : undefined}
  structuredData={jsonLd}
>
  <div class="blog-post">
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <a href="/articles" class="back-link">All writing</a>
    <CategoryNav />
    <p class="eyebrow">{category ?? "Category pending"}</p>
    <h1 class="mt-3 text-4xl md:text-5xl">{title}</h1>
    <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-stone">
      <span>By {author}</span>
      <span aria-hidden="true">&middot;</span>
      {!entry.data.evergreen && <>
        {date ? <time datetime={date.toISOString()}>{formatDate(date)}</time> : <span class="italic">Date pending</span>}
        <span aria-hidden="true">&middot;</span>
      </>}
      <span>{minutes} min read</span>
    </div>
    <ArticleShare title={title} url={new URL(`/articles/${entry.id}/`, SITE.url).href} />

    {image && (
      <Image
        src={image}
        alt={imageAlt ?? title}
        width={1200}
        height={750}
        class="mt-10 w-full rounded-lg object-cover"
      />
    )}

    <div class="prose-article mt-10">
      {contentPending && (
        <div class="not-prose mb-8">
          <ContentPendingNotice variant={aiDraft ? "ai-draft" : "empty"} />
        </div>
      )}
      <AffiliateDisclosure />
      <Content />
    </div>
    <ArticleShare title={title} url={new URL(`/articles/${entry.id}/`, SITE.url).href} />
    <AuthorBox />
  </article>

  {(prev || next) && (
    <nav aria-label="Article navigation" class="mx-auto max-w-3xl px-6 pb-16 grid gap-4 sm:grid-cols-2 border-t border-ink/10 pt-10">
      {prev ? (
        <a href={`/articles/${prev.id}`} class="group">
          <p class="eyebrow">Previous</p>
          <p class="mt-1 font-display text-lg group-hover:text-clay">{prev.data.title}</p>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/articles/${next.id}`} class="group sm:text-right">
          <p class="eyebrow">Next</p>
          <p class="mt-1 font-display text-lg group-hover:text-clay">{next.data.title}</p>
        </a>
      ) : <div />}
    </nav>
  )}

  {related.length > 0 && (
    <section class="border-t border-ink/10 bg-parchment-dim/50">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <p class="eyebrow mb-8">Related writing</p>
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => <li><ArticleCard entry={r} /></li>)}
        </ul>
      </div>
    </section>
  )}
  </div>
</BaseLayout>

<style>
  .blog-post { background: #fffefa; color: #202d25; }
  .blog-post :global(h1), .blog-post :global(h2), .blog-post :global(h3),
  .blog-post :global(.prose-article strong) { color: #172c22; }
  .blog-post :global(.prose-article) { color: #29372e; }
  .blog-post :global(.text-stone), .blog-post :global(.text-ink-soft),
  .blog-post :global(.author-box p:not(.eyebrow)) { color: #414e44; }
  .blog-post :global(.eyebrow), .blog-post :global(.back-link),
  .blog-post :global(.prose-article a), .blog-post :global(.author-links a) { color: #71351e; }
  .blog-post :global(.prose-article a:hover), .blog-post :global(.author-links a:hover),
  .blog-post :global(.back-link:hover) { color: #193b32; text-decoration-thickness: 2px; }
  .blog-post :global(.prose-article blockquote) {
    color: #193b32; background: #edf2eb; border-left: 4px solid #315b43;
    padding: 1rem 1.5rem; border-radius: 0 8px 8px 0;
  }
  .blog-post :global([role="note"]) { background: #f7eee0; border-color: #885136; }
  .blog-post :global([role="note"] svg) { color: #71351e; }
  .blog-post :global(.category-nav a), .blog-post :global(.share-actions a),
  .blog-post :global(.share-actions button) { color: #253d2f; background: #fff; border-color: #738277; }
  .blog-post :global(.category-nav a:hover), .blog-post :global(.share-actions a:hover),
  .blog-post :global(.share-actions button:hover) { background: #e5ece4; border-color: #193b32; }
  .blog-post :global(.category-nav .category-all) { background: #193b32; color: #fffdf5; border-color: #193b32; }
  .blog-post :global(.category-nav .category-all:hover) { background: #102a22; }
  .blog-post :global(.article-share) { border-color: #89978b; }
  .blog-post :global(.share-status) { color: #193b32; font-weight: 600; }
  .blog-post :global(.author-box) { background: #edf2eb; border-color: #89978b; }
  .blog-post :global(a:focus-visible), .blog-post :global(button:focus-visible),
  .blog-post :global(input:focus-visible) { outline: 3px solid #193b32; outline-offset: 4px; }
  .blog-post :global(.article-card:hover h3),
  .blog-post :global(nav[aria-label="Article navigation"] a:hover) { color: #71351e; text-decoration: underline; }
</style>
