---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Affiliate Disclaimer" description="Information about affiliate links on Aaron Joseph Hall's website." path="/legal/affiliate-disclaimer/">
  <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="eyebrow">Disclosure</p>
    <h1 class="mt-3 text-4xl md:text-5xl">Affiliate Disclaimer</h1>
    <div class="prose-article mt-10">
      <p>Some links on this website, including links in blog posts and book pages, may be affiliate links. If you follow an affiliate link and make a qualifying purchase, I may earn a commission.</p>
      <h2>Amazon Associates</h2>
      <p>As an Amazon Associate, I earn from qualifying purchases.</p>
      <h2>Before you buy</h2>
      <p>An affiliate relationship means I may receive compensation for a purchase made through a link. Please consider whether a product is right for you and review the seller’s current price, description, and terms before purchasing.</p>
      <h2>Questions</h2>
      <p>If you have questions about a link or disclosure on this site, please <a href="/contact/">contact me</a>.</p>
    </div>
  </section>
</BaseLayout>
